[configuration]

entry_symbol = "emil_library_init"
compatibility_minimum = "4.5"

[libraries]

linux.debug.arm64 = "res://bin/libemil.linux.arm64.so"
linux.release.arm64 = "res://bin/libemil.linux.arm64.so"
android.debug.arm64 = "res://bin/libemil.android.arm64.so"
android.release.arm64 = "res://bin/libemil.android.arm64.so"
